msgstr ""
"Project-Id-Version: scroll-speed 0.2\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Acceleration"
msgstr "Accélération"

msgid "Scroll further when the wheel spins fast"
msgstr "Défiler plus loin quand la molette tourne vite"

msgid "Off"
msgstr "Aucune"

msgid "Line %d"
msgstr "Ligne %d"

msgid "Mouse wheel"
msgstr "Molette de la souris"

msgid "Change the scroll speed"
msgstr "Modifier la vitesse de défilement"

msgid "Touchpad"
msgstr "Pavé tactile"

msgid "Two-finger scrolling"
msgstr "Défilement à deux doigts"

msgid "Pointing stick"
msgstr "TrackPoint"

msgid "Middle button held"
msgstr "Bouton du milieu maintenu"

msgid "Devices"
msgstr "Périphériques"

msgid "Mouse"
msgstr "Souris"

msgid "Scroll speed"
msgstr "Vitesse de défilement"

msgid "1× is the normal speed"
msgstr "1× = vitesse normale"

msgid "Same speed for horizontal scrolling"
msgstr "Même vitesse pour le défilement horizontal"

msgid "Horizontal scroll speed"
msgstr "Vitesse de défilement horizontal"

msgid "Nothing was changed"
msgstr "Rien n'a été modifié"

msgid "No access yet"
msgstr "Pas encore d'accès"

msgid "Active"
msgstr "Active"

msgid "Normal speed"
msgstr "Vitesse normale"

msgid "Starting…"
msgstr "Démarrage…"

msgid "Authorization granted"
msgstr "Autorisation accordée"

msgid "The helper could not be started"
msgstr "L'assistant n'a pas pu démarrer"

msgid "Scroll Speed needs Python 3, which was not found."
msgstr "Scroll Speed a besoin de Python 3, qui est introuvable."

msgid "Authorization needed"
msgstr "Autorisation nécessaire"

msgid ""
"Let your session read the mouse, touchpad and pointing stick, and replay "
"them with the new scroll speed. Asked once, with your password."
msgstr ""
"Permet à votre session de lire la souris, le pavé tactile et le TrackPoint, "
"et de les rejouer avec la nouvelle vitesse de défilement. Demandée une seule "
"fois, avec votre mot de passe."

msgid "Authorization to renew"
msgstr "Autorisation à renouveler"

msgid ""
"The one installed by an earlier version only covers mice, not touchpads and "
"pointing sticks."
msgstr ""
"Celle installée par une version précédente ne couvre que les souris, pas "
"les pavés tactiles ni les TrackPoint."

msgid "Authorize…"
msgstr "Autoriser…"

msgid "Authorization installed, but not effective yet"
msgstr "Autorisation installée, mais pas encore effective"

msgid "Authorize again. If that does not help, restart the computer."
msgstr "Autorisez à nouveau. Si cela ne suffit pas, redémarrez l'ordinateur."

msgid "Authorize again…"
msgstr "Autoriser à nouveau…"

msgid "No mouse, touchpad or pointing stick detected"
msgstr "Aucune souris, aucun pavé tactile ni TrackPoint détecté"

msgid "Plug in a mouse: it will be picked up within a few seconds."
msgstr "Branchez une souris : elle sera prise en compte en quelques secondes."

msgid "Remove the authorization"
msgstr "Retirer l'autorisation"

msgid ""
"Deletes the udev rule. Access already granted lasts until the next restart."
msgstr ""
"Supprime la règle udev. L'accès déjà accordé reste valable jusqu'au prochain "
"redémarrage."

msgid "Remove…"
msgstr "Retirer…"

msgid "Authorization removed"
msgstr "Autorisation retirée"

msgid "Try it"
msgstr "Essayer"

msgid "Scroll here to feel the speed; changes apply immediately."
msgstr ""
"Faites défiler ici pour sentir la vitesse ; les changements s'appliquent "
"immédiatement."

msgid "The virtual input device is not available"
msgstr "Le périphérique d'entrée virtuel n'est pas disponible"

msgid "Restart the computer so that the uinput kernel module is loaded."
msgstr "Redémarrez l'ordinateur pour que le module noyau uinput soit chargé."
